{
  "manifest_version": 3,
  "name": "Weltzeit-Karte",
  "version": "1.4.0",
  "description": "Zeigt in jedem neuen Tab eine Weltkarte mit Tag/Nacht-Grenze und den aktuellen Uhrzeiten der Zeitzonen.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
